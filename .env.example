# Copy to .env and fill in. Never commit .env.

# Google Gemini - generation and embeddings
GEMINI_API_KEY=

# Qdrant Cloud - vector search
QDRANT_URL=
QDRANT_API_KEY=

# Neon Postgres - chat history, users
NEON_DATABASE_URL=

# Auth - signs JWTs issued by POST /login. Generate a real random value for
# your own .env, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional - the backend falls back to the defaults shown in comments.
# Gemini model used for generation (default: gemini-2.0-flash)
GEMINI_CHAT_MODEL=
# Minimum cosine similarity for a retrieved passage to count (default: 0.62)
RELEVANCE_THRESHOLD=
# Comma-separated allowed browser origins for the chat widget (default: *)
CORS_ORIGINS=
# Public base URL of the published book, used to build source links
BOOK_BASE_URL=
